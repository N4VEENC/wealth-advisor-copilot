# Copy this file to .env and fill in your own real values — .env itself is
# gitignored and never committed. See the root README for where to get a
# free key for each of these.

# Required — AI narration (Dashboard insights, AI Chat, report generation).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Required — live market prices. Get a free key at https://finnhub.io/register
FINNHUB_API_KEY=

# Optional — comma-separated list of allowed frontend origins for CORS,
# e.g. https://your-deployed-frontend.example.com. Leave unset for local
# development: the backend then accepts any http://localhost:<port> origin
# automatically, which is all a local Vite dev server ever needs.
ALLOWED_ORIGINS=
